# ==============================================================================
# Agentic Professionals Launchpad & Portal Environment Configuration
# ==============================================================================

PORT=3001
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your-jwt-secret-here

# Shared Supabase Database & Auth (Pooled connection port 6543)
DATABASE_URL=postgresql://user:password@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Payment Gateway (Optional / Consultation Bookings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI & Media Integrations (Optional)
YOUTUBE_API_KEY=
SARVAM_API_KEY=

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=https://portal.agenticprofessionals.net,https://openibc.in,https://openbns.in
